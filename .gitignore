# Python、测试和编辑器缓存
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.pyc
*.pyo
*.pyd
.idea/
.DS_Store
~$*.docx
/tmp/
/artifacts/cache/

# 本地环境与凭据
.env
.env.*
!.env.example
.venv/
venv/

# 可由当前模型与历史档案重建的来源预测缓存。
/artifacts/runs/**/source_cache/
/artifacts/runs/**/source_priors.npz

# 源码、配置、结果、日志、实测数据、小型权重及其快照默认允许跟踪。
# 新增超大权重或数据时，按具体路径补充；不整体忽略 artifacts/ 或所有 zip/pt/npz。
