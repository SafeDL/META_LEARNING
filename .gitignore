# 可重新生成的训练特征、候选缓存和逐步预测。
/experiment_outputs/gcrt/**/historical/**/*.pt
/experiment_outputs/gcrt/**/pool_cache/*.pt
/experiment_outputs/gcrt/**/trajectories/**/*.pt
/experiment_outputs/gcrt/**/forecasts.json
