# Python、测试和编辑器缓存
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.pyc
*.pyo
*.pyd
.idea/
.DS_Store

# 本地环境与凭据
.env
.env.*
!.env.example
.venv/
venv/

# 可重新生成的训练特征、候选缓存和逐步预测。
/results/baselines/lrt/feature_cache/
/results/baselines/lrt/by_family/*/feature_cache/
/results/baselines/lrt/by_family/*/pool_cache/*.pt
/results/baselines/lrt/adaptive/*/historical/**/*.pt
/results/gcrt/**/historical/**/*.pt
/results/gcrt/**/pool_cache/*.pt
/results/gcrt/**/trajectories/**/*.pt
/results/gcrt/**/forecasts.json

# 仅用于中断续训的优化器状态；正式权重和训练记录保留。
/results/baselines/dart/**/models/resume_*.pt
/results/baselines/lrt/models/resume_*.pt
/results/baselines/lrt/by_family/**/models/resume_*.pt

# 源码、配置、结果、日志、实测数据、小型权重及其快照默认允许跟踪。
# 新增超大权重或数据时，按具体路径补充；不整体忽略 results/ 或所有 zip/pt/npz。
