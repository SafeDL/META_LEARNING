  "e1": {
    "implementation": "testing_methods/history_transfer/reliability.py",
    "feature": "frozen target-kernel historical embedding",
    "distance": "Euclidean in that embedding; Gaussian weights exp(-d^2/(2*h^2))",
    "bandwidth": "h=exp(frozen target-kernel log_lengthscale), lower bound 0.01",
    "error": "prequery collision log likelihood, clipped at 1e-15",
    "local_mean": "l_s(x)=sum_i K_i(x)*log_likelihood_i,s / sum_i K_i(x)",
    "global_mean": "g_s=mean_i log_likelihood_i,s",
    "shrinkage": "alpha(x)=sum_i K_i(x)/(sum_i K_i(x)+20)",
    "weight": "0.9*softmax_s(global_log_score_s+alpha(x)*t*(l_s(x)-g_s))",
    "fallback": "no paid records or zero kernel mass gives global weights",
    "raw_component_weight": 0.1,
    "weighted_components": "all historical sources and independent target; raw excluded",
    "additional_trainable_parameters": 0,
    "additional_optimization_steps": 0,
    "device": "cpu",
    "precision": "float64",
    "torch_threads": 1,
    "batch_size": 128,
    "max_task_wall_s": 1800,
    "max_task_cpu_gib": 8,
    "max_task_gpu_gib": 0,
    "diagnostic": {
      "split": "fixed midpoint of each original continuous parameter range",
      "midpoint_assignment": "lower side includes midpoint",
      "minimum_paid_records_per_side": 5,
      "criterion": "same source-pair Brier ordering reversal at consecutive checkpoints",
      "tie_tolerance": 1e-12,
      "historical_sources_only": true
    },
    "check_command": "python -B -m pytest tests/history_transfer/test_reliability.py tests/experiments/test_method_exploration.py",
    "expected_checks": "normalized positive weights, global fallback, local reversal, chunk invariance and future-feedback isolation"
  },
  "e2": {
    "implementation": "testing_methods/history_transfer/shared_private.py",
    "latent_model": "f=sf*(sqrt(q)*u+sqrt(1-q)*v); r=sr*(a*u+sqrt(1-a^2)*w); u,v,w independent unit-variance Matern-5/2 GPs",
    "fraction": "q=sigmoid(raw_shared_fraction)",
    "sharing": "a=tanh(raw_correlation); all shared output covariance is zero when a=0",
    "covariance": {
      "ff": "sf^2*(q*k_shared+(1-q)*k_collision)",
      "rr": "sr^2*(a^2*k_shared+(1-a^2)*k_rss)",
      "fr": "sf*sr*sqrt(q)*a*k_shared",
      "source": "C_source'=abs(a)*C_source+(1-abs(a))*blockdiag(C_ff,C_rr)"
    },
    "scales": "sf=exp(log_scale); sr=exp(log_margin_scale), absolute RSS standard deviation",
    "initial_values": {
      "q": 0.5,
      "a": -0.5,
      "shared_length": 0.3,
      "collision_length": 0.3,
      "rss_length": 0.3,
      "sf": 1.0,
      "sr": 0.3,
      "collision_mean": -1.4,
      "rss_mean": 0.5
    },
    "prior_loading_scope": "functional-scenario scalars; spatial differences through historical embedding, separate latent length scales and conditional posteriors",
    "zero_sharing_check": "set a=0 in target and raw kernels; source cross-output blocks also vanish; fixed remaining parameters reproduce collision-only conditioning",
    "rss_observation_noise_sd": 0.05,
    "offline_additional_scalars": [
      "raw_shared_fraction",
      "log_collision_lengthscale",
      "log_rss_lengthscale"
    ],
    "online_scalars": [
      "mean",
      "margin_mean",
      "log_lengthscale",
      "log_scale",
      "log_margin_scale",
      "raw_correlation"
    ],
    "online_initialization": "fixed learned base each round; raw component starts at fixed defaults",
    "online_steps": 10,
    "online_learning_rates": {
      "target": 0.003,
      "raw": 0.01
    },
    "online_gradient_clipping": "norm 5 separately for (margin_mean,log_margin_scale) and the other trainable parameters; original model retains its original single group",
    "offline": {
      "steps": 1500,
      "learning_rate": 0.001,
      "initial_count": 20,
      "budget": 200,
      "historical_context": 64,
      "diagnostic_interval": 100,
      "seed": 1301,
      "device": "cpu",
      "historical_rss": true
    },
    "offline_scope": "all eight original historical ADS archives per scenario; two stages trained from scratch, final checkpoints, no target or development responses",
    "source_views": "exact full-method view_record_ids from the original per-scenario snapshot",
    "source_weights": "global, query-before-feedback collision likelihood only; E1 not combined",
    "group_prior": {
      "history": 0.75,
      "independent_target": 0.25,
      "raw_mass": 0.1
    },
    "controls": "reuse archived original full-method and target-collision-only runs; training/model differences make this a workflow comparison",
    "conditional_diagnostic": "at each paid prefix hold parameters, source snapshot and weights fixed; compare p(U|Y,R) with p(U|Y) for the same new model; unqueried truth enters evaluation only",
    "device": "cpu",
    "precision": "float64",
    "workers": 4,
    "torch_threads": 1,
    "batch_size": 128,
    "max_build_wall_s": 86400,
    "max_build_cpu_gib": 24,
    "max_build_gpu_gib": 0,
    "max_task_wall_s": 1800,
    "max_task_cpu_gib": 8,
    "max_task_gpu_gib": 0,
    "resource_basis": "archived per-scenario training took 20,200-21,300 s and up to about 5 GiB CPU; allow three-kernel construction overhead without reducing training steps",
    "check_command": "python -B -m pytest tests/history_transfer/test_shared_private.py tests/history_transfer/test_joint_feedback.py tests/history_transfer/test_training.py tests/history_transfer/test_sequential_training.py tests/history_transfer/test_raw_target.py -q",
    "expected_checks": "independent latent covariance, PSD, source contraction, zero-sharing conditioning and optimizer isolation, dense/block agreement, six online scalars, strict typed checkpoints, batch invariant selection and future-feedback isolation"
  },
  "e3": {
    "implementation": "testing_methods/history_transfer/lookahead.py",
    "response_model": "exact original joint kernel, encoder and source calculation record IDs",
    "utility": "p(x)+mean_fantasy(sum of top remaining_budget-1 probabilities excluding x)",
    "shortlist": "top 2 collision probabilities, then highest weighted component-probability variance until 4 unique candidates; ties by scenario ID at 1e-12 tolerance",
    "shortlist_count": 4,
    "fantasy_count": 4,
    "seed": 11,
    "sampling": "scrambled 4-D Sobol, seed=11+paid_prefix_count; common uniforms per shortlist; mixture component, 2 Gaussian latent coordinates, Bernoulli-logistic collision draw",
    "rss_observation_noise_sd": 0.05,
    "rss_fantasy_support": "unbounded Gaussian approximation; no clipping or conversion to physical QueryFeedback; record below-minus-one probability and sample fraction",
    "fantasy_update": "prequery collision likelihood updates global source weights, then target and raw kernels each adapt six scalars for 10 steps from fixed initialization; learning rates 0.003 and 0.01; predict remaining candidates in batches of 128",
    "last_query": "exact greedy choice with zero fantasy branches",
    "common_diagnostics": "compute hypothetical choices at 20,50,100 paid records while executing the saved Random order; at budget 200 only the unchanged prediction is recorded",
