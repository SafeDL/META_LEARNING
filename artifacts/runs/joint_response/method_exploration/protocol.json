    "check_command": "python -B -m pytest tests/history_transfer/test_lookahead.py tests/history_transfer/test_joint_feedback.py tests/history_transfer/test_feature_cache.py tests/history_transfer/test_reliability.py tests/experiments/test_source_registration.py tests/experiments/test_source_audit.py -q",
    "regression_check_command": "python -B -c \"from experiments.lookahead_exploration import check_original_prefixes; check_original_prefixes()\"",
